+static void printKittyVirtualLogo(FFstrbuf* buf, const FFstrbuf* base64, const FFOptionsLogo* options) {
+    // Reuse the same image ID for the same logo and geometry in scrollback.
+    uint32_t id = 2166136261u;
+    for (uint32_t i = 0; i < options->source.length; ++i) {
+        id = (id ^ (uint8_t) options->source.chars[i]) * 16777619u;
+    }
+    id = (id ^ options->width) * 16777619u;
+    id = ((id ^ options->height) * 16777619u) & 0xFFFFFFu;
+    if (!id) id = 1;
+
+    ffStrbufAppendF(buf, "\ePtmux;\e\e_Ga=T,f=100,t=f,U=1,q=2,i=%u,c=%u,r=%u;%s\e\e\\\e\\",
+        (unsigned) id, (unsigned) options->width, (unsigned) options->height, base64->chars);
+    ffWriteFDBuffer(FFUnixFD2NativeFD(STDOUT_FILENO), buf);
+    ffStrbufClear(buf);
+
+    for (uint32_t row = 0; row < options->height; ++row) {
+        ffStrbufAppendF(buf, "\e[38;2;%u;%u;%um", (unsigned) (id >> 16),
+            (unsigned) ((id >> 8) & 0xFF), (unsigned) (id & 0xFF));
+        for (uint32_t column = 0; column < options->width; ++column) {
+            ffStrbufAppendUtf32CodePoint(buf, 0x10EEEE);
+            ffStrbufAppendUtf32CodePoint(buf, kittyCellDiacritics[row]);
+            ffStrbufAppendUtf32CodePoint(buf, kittyCellDiacritics[column]);
+        }
+        ffStrbufAppendC(buf, '\n');
+    }
+    ffLogoPrintChars(buf->chars, false);
+}
