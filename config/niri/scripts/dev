#!/usr/bin/env bash
set -euo pipefail

CLASS="dev.terminal"
DIR="${HOME}/nixos-dotfiles"
GHOSTTY="$(command -v ghostty)"

niri msg action focus-workspace dev
sleep 0.1

dev_id=$(niri msg --json workspaces | jq -r '.[] | select(.name == "dev") | .id')
if [[ -z "$dev_id" || "$dev_id" == "null" ]]; then
  echo "dev workspace not found" >&2
  exit 1
fi

t_id=$(niri msg --json windows \
  | jq -r --arg c "$CLASS" --argjson id "$dev_id" \
    '.[] | select(.app_id == $c and .workspace_id == $id) | .id' \
  | head -n1)

if [[ -n "${t_id:-}" ]]; then
  niri msg action focus-window --id "$t_id" || true
  exit 0
fi

niri msg action spawn -- "$GHOSTTY" --class="$CLASS" --working-directory="$DIR"
